// Tags are bare X.Y.Z (no "v" prefix); -SNAPSHOT keeps untagged/dirty builds routed to the
// snapshot repo below instead of Central.
ThisBuild / dynverVTagPrefix        := false
ThisBuild / dynverSonatypeSnapshots := true

lazy val scala3   = "3.3.9"
lazy val scala213 = "2.13.18"
lazy val scala212 = "2.12.21"

ThisBuild / scalaVersion := scala3

val buildCommit    = settingKey[String]("Build info: commit")
val buildTimestamp = settingKey[String]("Build info: timestamp")

ThisBuild / buildCommit    := Version.commit(GitCli.headCommit)
ThisBuild / buildTimestamp := Version.timestamp

ThisBuild / name         := "telegramium"
ThisBuild / organization := "io.github.apimorphism"
ThisBuild / homepage     := Some(url("https://github.com/apimorphism/telegramium"))
ThisBuild / licenses     := List(("MIT", url("https://opensource.org/licenses/MIT")))

ThisBuild / scmInfo := Some(
  ScmInfo(
    url("https://github.com/apimorphism/telegramium"),
    "git@github.com:apimorphism/telegramium.git"
  )
)

ThisBuild / developers := List(
  Developer(
    "sherzod",
    "Sherzod Gapirov",
    "sh.gapirov@gmail.com",
    url("https://github.com/sherzodv")
  )
)

ThisBuild / publishMavenStyle := true
ThisBuild / publishTo         := {
  val centralSnapshots = "https://central.sonatype.com/repository/maven-snapshots/"
  if (isSnapshot.value) Some("central-snapshots" at centralSnapshots)
  else localStaging.value
}

ThisBuild / githubWorkflowScalaVersions := Seq(scala3, scala213, scala212)

// The oldest supported JDK and the newest LTS. Compile-time Java 8 compatibility comes from -release 8 (Compiler.scala),
// so JDK 8 is here for what only shows at runtime, like a dependency that no longer runs on 8.
lazy val jdk8  = JavaSpec.temurin("8")
lazy val jdk21 = JavaSpec.temurin("21")

ThisBuild / githubWorkflowJavaVersions := Seq(jdk21, jdk8)

ThisBuild / githubWorkflowPublishTargetBranches := Seq.empty

// The checks don't depend on the JDK, and scalafmt not on the Scala version either: each runs once, not in every job
ThisBuild / githubWorkflowBuildPreamble ++=
  Seq(
    WorkflowStep.Sbt(List("scalafixAll --check"), cond = Some(s"matrix.java == '${jdk21.render}'")),
    WorkflowStep.Sbt(
      List("scalafmtCheckAll", "scalafmtSbtCheck"),
      cond = Some(s"matrix.java == '${jdk21.render}' && matrix.scala == '$scala3'")
    )
  )

Global / onChangedBuildSource := ReloadOnSourceChanges

val settings = Compiler.settings ++ Seq()

// Live tests talk to real Telegram (see TelegramLiveSpec): plain `sbt test` skips them, `sbt liveTest` runs only them
val onlyLiveTests = settingKey[Boolean]("Run only the tests tagged LiveTest, instead of skipping them")
ThisBuild / onlyLiveTests := false

lazy val `telegramium-core` = (projectMatrix in file("telegramium-core"))
  .jvmPlatform(scalaVersions = Seq(scala3, scala213, scala212))
  .enablePlugins(BuildInfoPlugin)
  .disablePlugins(ScalafixPlugin)
  .settings(settings: _*)
  .settings(libraryDependencies ++= Dependencies.telegramiumCore)
  .settings(
    // generators generated by iozhik, in a tree of their own that a regen wipes
    Test / unmanagedSourceDirectories += (Test / sourceDirectory).value / "scala-generated",
    buildInfoKeys := Seq[BuildInfoKey](
      buildCommit,
      buildTimestamp
    ),
    buildInfoPackage := "telegramium.bots.buildinfo"
  )

lazy val `telegramium-high` = (projectMatrix in file("telegramium-high"))
  .jvmPlatform(scalaVersions = Seq(scala3, scala213, scala212))
  // test->test: the wire checks use the generators generated into telegramium-core's tests
  .dependsOn(`telegramium-core` % "compile->compile;test->test")
  .settings(settings: _*)
  .settings(
    semanticdbEnabled := true,
    semanticdbVersion := scalafixSemanticdb.revision
  )
  .settings(libraryDependencies ++= Dependencies.telegramiumHigh)
  .settings(
    Test / testOptions += Tests.Argument(
      TestFrameworks.ScalaTest,
      if (onlyLiveTests.value) "-n" else "-l",
      "telegramium.bots.high.LiveTest"
    )
  )

lazy val `telegramium-examples` = (projectMatrix in file("telegramium-examples"))
  .jvmPlatform(scalaVersions = Seq(scala3))
  .dependsOn(
    `telegramium-core`,
    `telegramium-high`
  )
  .settings(settings: _*)
  .settings(
    publish / skip    := true,
    semanticdbEnabled := true,
    semanticdbVersion := scalafixSemanticdb.revision
  )
  .settings(libraryDependencies ++= Dependencies.telegramiumExam)

lazy val telegramium = (project in file("."))
  .settings(
    name           := "F[Tg]",
    publish / skip := true
  )
  .aggregate(
    `telegramium-core`.projectRefs ++
      `telegramium-high`.projectRefs ++
      `telegramium-examples`.projectRefs: _*
  )

addCommandAlias("fmtAll", "scalafixAll; scalafmtAll; scalafmtSbt")
// one Scala version is enough: what's checked is Telegram's answer, not the cross-build
addCommandAlias("liveTest", "set ThisBuild / onlyLiveTests := true; telegramium-high3/test")
