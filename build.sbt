// No Scala axis in CI: the matrix projects each keep their own Scala version, so `test` on the root already tests all
// three, and `++ X; test` in a job per version would test all three in each. The axis defaults to crossScalaVersions,
// which is just scalaVersion here

// The oldest supported JDK and the newest LTS. Compile-time Java 8 compatibility comes from -release 8 (Compiler.scala),
// so JDK 8 is here for what only shows at runtime, like a dependency that no longer runs on 8.
lazy val jdk8  = JavaSpec.temurin("8")
lazy val jdk21 = JavaSpec.temurin("21")

ThisBuild / githubWorkflowJavaVersions := Seq(jdk21, jdk8)

ThisBuild / githubWorkflowPublishTargetBranches := Seq.empty

// The checks don't depend on the JDK: each runs once, not in every job
ThisBuild / githubWorkflowBuildPreamble ++=
  Seq(
    WorkflowStep.Sbt(List("scalafixAll --check"), cond = Some(s"matrix.java == '${jdk21.render}'")),
    WorkflowStep.Sbt(List("scalafmtCheckAll", "scalafmtSbtCheck"), cond = Some(s"matrix.java == '${jdk21.render}'"))
  )

Global / onChangedBuildSource := ReloadOnSourceChanges

// Central caps an org's monthly upload size, and Scala 2 scaladoc was 2/3 of a release. The API is the same in every
// Scala version, so only _3 ships scaladoc; 2.x ships the placeholder -javadoc.jar Central still requires.
val scaladocSettings = Seq(
  Compile / doc / sources := {
    if (scalaBinaryVersion.value == "3") (Compile / doc / sources).value else Nil
  },
  Compile / packageDoc / mappings ++= {
    if (scalaBinaryVersion.value == "3") Nil
    else {
      val docs   = s"https://javadoc.io/doc/${organization.value}/${moduleName.value}_3/${version.value}"
      val readme = target.value / "javadoc-placeholder" / "README.md"
      IO.write(
        readme,
        s"Scaladoc is published only for Scala 3, and the API is the same in every Scala version:\n$docs\n"
      )
      Seq(readme -> "README.md")
    }
  }
)

val settings = Compiler.settings ++ scaladocSettings

// Live tests talk to real Telegram (see TelegramLiveSpec): plain `sbt test` skips them, `sbt liveTest` runs only them
val onlyLiveTests = settingKey[Boolean]("Run only the tests tagged LiveTest, instead of skipping them")
ThisBuild / onlyLiveTests := false

lazy val `telegramium-core` = (projectMatrix in file("telegramium-core"))
  .jvmPlatform(scalaVersions = Seq(scala3, scala213, scala212))
  .enablePlugins(BuildInfoPlugin)
  .disablePlugins(ScalafixPlugin)
  .settings(settings: _*)
  .settings(libraryDependencies ++= Dependencies.telegramiumCore)
  .settings(
    // generators generated by iozhik, in a tree of their own that a regen wipes
    Test / unmanagedSourceDirectories += (Test / sourceDirectory).value / "scala-generated",
    buildInfoKeys := Seq[BuildInfoKey](
      buildCommit,
      buildTimestamp
    ),
    buildInfoPackage := "telegramium.bots.buildinfo"
  )

lazy val `telegramium-high` = (projectMatrix in file("telegramium-high"))
  .jvmPlatform(scalaVersions = Seq(scala3, scala213, scala212))
  // test->test: the wire checks use the generators generated into telegramium-core's tests
  .dependsOn(`telegramium-core` % "compile->compile;test->test")
  .settings(settings: _*)
  .settings(
    semanticdbEnabled := true,
    semanticdbVersion := scalafixSemanticdb.revision
  )
  .settings(libraryDependencies ++= Dependencies.telegramiumHigh)
  .settings(
    // tests that need what 2.12 lacks, such as productElementNames
    Test / unmanagedSourceDirectories ++=
      (if (scalaBinaryVersion.value == "2.12") Nil else Seq((Test / sourceDirectory).value / "scala-2.13+")),
    Test / testOptions += Tests.Argument(
      TestFrameworks.ScalaTest,
      if (onlyLiveTests.value) "-n" else "-l",
      "telegramium.bots.high.LiveTest"
    )
  )

lazy val `telegramium-examples` = (projectMatrix in file("telegramium-examples"))
  .jvmPlatform(scalaVersions = Seq(scala3))
  .dependsOn(
    `telegramium-core`,
    `telegramium-high`
  )
  .settings(settings: _*)
  .settings(
    publish / skip    := true,
    semanticdbEnabled := true,
    semanticdbVersion := scalafixSemanticdb.revision
  )
  .settings(libraryDependencies ++= Dependencies.telegramiumExam)

// Scalafix migration rules, one per breaking release. Users and Scala Steward run them from GitHub
// (`github:apimorphism/telegramium/<Rule>?sha=<tag>`), so nothing here is published. The rule source must stay at
// scalafix/rules/src/main/scala/fix/<Rule>.scala and depend on scalafix-core only.
lazy val `scalafix-rules` = (project in file("scalafix/rules"))
  // plain Scala 2.13, as scalafix compiles a rule: the repo's Scala 3 import style wouldn't parse there
  .disablePlugins(ScalafixPlugin)
  .settings(
    scalaVersion                           := scala213,
    publish / skip                         := true,
    libraryDependencies += "ch.epfl.scala" %% "scalafix-core" % _root_.scalafix.sbt.BuildInfo.scalafixVersion
  )

// The code a rule migrates, on the last release before it, and what the rule should make of it, on this build. Scala 3
// as most bots are, and there scalafix can't read a dependency's signatures, so a rule must not need them.
lazy val `scalafix-input` = (project in file("scalafix/input"))
  .disablePlugins(ScalafixPlugin)
  .settings(
    scalaVersion                                   := scala3,
    publish / skip                                 := true,
    semanticdbEnabled                              := true,
    libraryDependencies += "io.github.apimorphism" %% "telegramium-high" % "10.1003.2"
  )

lazy val `scalafix-output` = (project in file("scalafix/output"))
  .disablePlugins(ScalafixPlugin)
  .dependsOn(`telegramium-high`.jvm(scala3))
  .settings(
    scalaVersion   := scala3,
    publish / skip := true
  )

lazy val `scalafix-tests` = (project in file("scalafix/tests"))
  // plain Scala 2.13, as scalafix compiles a rule: the repo's Scala 3 import style wouldn't parse there
  .disablePlugins(ScalafixPlugin)
  .enablePlugins(ScalafixTestkitPlugin)
  .dependsOn(`scalafix-rules`)
  .settings(
    scalaVersion                           := scala213,
    publish / skip                         := true,
    libraryDependencies += ("ch.epfl.scala" % "scalafix-testkit" % _root_.scalafix.sbt.BuildInfo.scalafixVersion % Test)
      .cross(CrossVersion.full),
    // scala-reports holds the output of what the rule only reports, which doesn't compile on this build
    scalafixTestkitOutputSourceDirectories := (`scalafix-output` / Compile / unmanagedSourceDirectories).value :+
      (`scalafix-output` / baseDirectory).value / "src/main/scala-reports",
    scalafixTestkitInputSourceDirectories := (`scalafix-input` / Compile / unmanagedSourceDirectories).value,
    scalafixTestkitInputClasspath         := (`scalafix-input` / Compile / fullClasspath).value,
    scalafixTestkitInputScalacOptions     := (`scalafix-input` / Compile / scalacOptions).value,
    scalafixTestkitInputScalaVersion      := (`scalafix-input` / Compile / scalaVersion).value,
    // the output must compile against this build
    Test / test := (Test / test).dependsOn(`scalafix-output` / Compile / compile).value
  )

lazy val telegramium = (project in file("."))
  .settings(
    name           := "F[Tg]",
    publish / skip := true
  )
  .aggregate(
    `telegramium-core`.projectRefs ++
      `telegramium-high`.projectRefs ++
      `telegramium-examples`.projectRefs ++
      Seq[ProjectReference](`scalafix-rules`, `scalafix-input`, `scalafix-output`, `scalafix-tests`): _*
  )

addCommandAlias("fmtAll", "scalafixAll; scalafmtAll; scalafmtSbt")
// one Scala version is enough: what's checked is Telegram's answer, not the cross-build
addCommandAlias("liveTest", "set ThisBuild / onlyLiveTests := true; telegramium-high3/test")
